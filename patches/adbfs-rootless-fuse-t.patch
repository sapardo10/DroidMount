+// with rootdir=/sdcard so the volume is the phone's user storage directly —
+// at startup a symlink root is resolved (on most phones /sdcard points at
+// /storage/emulated/0), because `ls -ld` on a symlink looks like "no file".
+static string devRoot = "/";
+static string devPath(const string& fusePath) {
+    if (devRoot == "/") return fusePath;
+    if (fusePath == "/") return devRoot;
+    return devRoot + fusePath;
+}
