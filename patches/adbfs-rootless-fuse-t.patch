+static const long long LARGE_READ       = 128LL * 1024;
+static const long long PULL_UPGRADE_MAX = 256LL * 1024 * 1024;
+static const long long PULL_UPGRADE_AT  = 8LL * 1024 * 1024;
+// Bound a single dd fetch so a huge read request can't blow up the buffer.
+static const size_t   MAX_DD_FETCH      = 8 * 1024 * 1024;
