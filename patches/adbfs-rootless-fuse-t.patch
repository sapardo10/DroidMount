+// DroidMount (lazy-reads): read the size field out of an `ls -l -a -d` line.
+// Layout: mode nlink owner group size date time name, but when the nlink
+// column is 0 the owner/group pair shifts left (mirrors adb_getattr's
+// uid_offset, which indexes the size as uid_offset + 3).
+static long long parse_ls_size(const string& line) {
+    if (!is_valid_ls_output(line)) return -1;
+    vector<string> t = make_array(line);
+    int uid_offset = 0;
+    if (t.size() >= 2 && str_all_digits(t[1]) && atoi(t[1].c_str()) > 0)
+        uid_offset = 1;
+    size_t sizeIdx = (size_t)(3 + uid_offset);
+    if (t.size() < sizeIdx + 1) return -1;
+    if (!str_all_digits(t[sizeIdx])) return -1;
+    return atoll(t[sizeIdx].c_str());
+}
+
+static bool parse_ls_is_dir(const string& line) {
+    return is_valid_ls_output(line) && line[0] == 'd';
