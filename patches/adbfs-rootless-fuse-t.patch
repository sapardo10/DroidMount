+// DroidMount (lazy-reads): per-open state for read-only opens.
+// Finder/Quick Look open files in a folder just to preview them, so read-only
+// opens no longer adb-pull the whole file up front (see adb_open). Instead we
+// remember the remote size, fetch only the ranges actually read (adb_read),
+// and "upgrade" to a one-shot full pull once the client clearly wants the
+// content. Keyed by the fd we hand back in fi->fh.
+struct ReadOnlyState {
+    long long size;     // remote size in bytes (-1 = unknown)
+    bool pulled;        // full content fetched locally; serve via pullFd
+    long long ddBytes;  // bytes served via dd range reads so far
+    int pullFd;         // fd for the pulled file (-1 = none). adb pull
+                        // REPLACES the temp file (new inode), so the fd from
+                        // adb_open goes stale and must be re-opened.
+};
+static map<int, ReadOnlyState> roState;
+static std::mutex roStateLock;
+
+// One mutex per remote path, serializing adb_pull/push of the same file
+// across concurrent FUSE threads (the libfuse 2 handler runs multithreaded).
+static map<string, shared_ptr<mutex>> pullLocks;
+static mutex pullLocksLock;
+
+static shared_ptr<mutex> pullMutexFor(const string& path) {
+    lock_guard<mutex> g(pullLocksLock);
+    map<string, shared_ptr<mutex>>::iterator it = pullLocks.find(path);
+    if (it == pullLocks.end())
+        it = pullLocks.insert(make_pair(path, shared_ptr<mutex>(new mutex()))).first;
+    return it->second;
+}
